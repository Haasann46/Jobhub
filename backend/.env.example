# ─── Переменные окружения для ЛОКАЛЬНОЙ разработки ───────────────────────────
# Этот файл НЕ загружается на GitHub (он в .gitignore)
# Для продакшна переменные задаются через Railway/Vercel

# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobhub

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT токены ───────────────────────────────────────────────────────────────
# ВАЖНО: Смените SECRET_KEY на свой длинный случайный набор символов!
# Можно сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Приложение ───────────────────────────────────────────────────────────────
APP_NAME=JobHub
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudinary (файлы: фото, PDF) ────────────────────────────────────────────
# Регистрируйтесь на cloudinary.com и вставьте свои данные
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── SendGrid (email) ─────────────────────────────────────────────────────────
# Регистрируйтесь на sendgrid.com (100 писем/день бесплатно)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@jobhub.com
